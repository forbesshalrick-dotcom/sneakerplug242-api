#!/bin/sh
# Blocks the \U0001 emoji bug from reaching a customer. See check-escapes.js.
# Shared by every session working in this checkout: git config core.hooksPath .githooks
node check-escapes.js server.js || {
  echo ""
  echo "Commit blocked. Fix the escapes above, or run with --no-verify if you are certain."
  exit 1
}
node --check server.js || { echo "server.js does not parse - commit blocked."; exit 1; }
